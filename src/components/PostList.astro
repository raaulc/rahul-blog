---
import type { CollectionEntry } from 'astro:content';
interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
const minutes = (p: CollectionEntry<'posts'>) => Math.max(1, Math.round((p.body ?? '').split(/\s+/).length / 200));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-entry">
      <time class="post-date" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      <a href={`/posts/${post.id}`} class="post-link">{post.data.title}</a>
      <span class="post-mins">{minutes(post)}m</span>
    </li>
  ))}
</ul>
