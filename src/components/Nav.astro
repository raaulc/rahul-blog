---
import { getNavSections, type NavId } from '../lib/sections';

interface Props {
  active?: NavId;
}
const { active } = Astro.props;
const links = [
  ...(await getNavSections()).map((s) => ({ id: s.id as NavId, href: s.href, label: s.label })),
  { id: 'about' as NavId, href: '/about', label: 'about' },
];
const CV = '/cv/Rahul_Rathod_CV.pdf';
---

<nav class="navbar" aria-label="Main">
  <a href="/" class="navbar-path">
    <span class="p-tilde">~/</span><span class="p-name">rahul</span>
  </a>
  <ul class="navbar-nav">
    {links.map((l) => (
      <li><a href={l.href} class:list={{ active: active === l.id }} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a></li>
    ))}
  </ul>
  <div class="navbar-tools">
    <a href={CV} class="nav-cv">cv</a>
    <a href="/search" class="nav-search" aria-label="Search" title="Search (press /)">⌕</a>
    <button type="button" class="theme-toggle" aria-label="Toggle colour theme" title="Toggle theme">◐</button>
  </div>
</nav>
