---
// Request path of the realtime-recs service. Horizontal on desktop, vertical on phones.
const stages = [
  { name: 'Play event', detail: 'POST /events updates history and the session window', kind: 'io' },
  { name: 'Retrieval', detail: 'SVD fold-in + item-kNN sums, top 100 each', time: '0.9 ms', kind: 'retrieval' },
  { name: 'Ranking', detail: '300 LightGBM trees over ~157 candidates, 12 features', time: '2.2 ms', kind: 'ranking' },
  { name: 'Guardrails', detail: 'cooldown, exclusions, diversity, explanations', time: '0.1 ms', kind: 'policy' },
  { name: 'Response', detail: 'items, reasons, rule codes, Server-Timing', kind: 'io' },
];
---

<figure class="arch">
  <ol class="arch-flow">
    {stages.map((s) => (
      <li class:list={['arch-stage', s.kind]}>
        <span class="arch-name">{s.name}</span>
        <span class="arch-detail">{s.detail}</span>
        {s.time && <span class="arch-time">p50 {s.time}</span>}
      </li>
    ))}
  </ol>
  <figcaption>No per-player model state: retrieval scores from play history alone, so each event changes the very next response.</figcaption>
</figure>
