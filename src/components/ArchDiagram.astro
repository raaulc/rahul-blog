---
// Request path of the realtime-recs service. Horizontal on desktop, vertical on phones.
const stages = [
  { name: 'Play event', detail: 'A play updates the player history and the current session', kind: 'io' },
  { name: 'Retrieval', detail: 'SVD and item kNN each pick their top 100 games', time: '0.9 ms', kind: 'retrieval' },
  { name: 'Ranking', detail: '300 LightGBM trees score about 157 candidates on 12 features', time: '2.2 ms', kind: 'ranking' },
  { name: 'Guardrails', detail: 'Cooldown, exclusions, diversity and a reason for each pick', time: '0.1 ms', kind: 'policy' },
  { name: 'Response', detail: 'Games, reasons, the rules that fired and timings', kind: 'io' },
];
---

<figure class="arch">
  <ol class="arch-flow">
    {stages.map((s) => (
      <li class:list={['arch-stage', s.kind]}>
        <span class="arch-name">{s.name}</span>
        <span class="arch-detail">{s.detail}</span>
        {s.time && <span class="arch-time">p50 {s.time}</span>}
      </li>
    ))}
  </ol>
  <figcaption>There is no per player model to update. Retrieval works from play history alone, so every play changes the very next response.</figcaption>
</figure>
