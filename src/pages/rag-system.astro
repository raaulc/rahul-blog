---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';

const posts = (await getCollection('posts'))
  .filter((p) => p.data.type === 'rag-system')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

---

<Base title="rag system" description="Building RAG systems from scratch — retrieval augmented generation, vector stores, and agentic pipelines." active="work">

      <a href="/projects" class="back-link">← cd ../work</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> ls</span>
        <span class="flag"> -lt</span>
        <span class="arg"> ./rag-system/</span>
      </p>

      <PostList posts={posts} />
</Base>
