---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';

const posts = (await getCollection('posts'))
  .filter((p) => p.data.type === 'llm-architecture')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

---

<Base title="llm architecture" description="Deep dives into LLM architecture — building language models from scratch with PyTorch." active="work">

      <a href="/projects" class="back-link">← cd ../work</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> ls</span>
        <span class="flag"> -lt</span>
        <span class="arg"> ./llm-architecture/</span>
      </p>

      <PostList posts={posts} />
</Base>
