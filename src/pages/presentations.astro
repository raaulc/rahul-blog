---
import Head from '../components/Head.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="presentations"
      description="System design presentations and technical walkthroughs by Rahul — covering agentic AI pipelines and engineering architecture."
    />
  </head>
  <body>
    <nav class="navbar">
      <span class="navbar-path">
        <span class="p-tilde">~/</span><span class="p-name">rahul</span>
      </span>
      <ul class="navbar-nav">
        <li><a href="/">blog</a></li>
        <li><a href="/projects">projects</a></li>
        <li><a href="/everything-else">everything-else</a></li>
        <li><a href="/presentations" class="active">presentations</a></li>
        <li><a href="/about">about</a></li>
      </ul>
    </nav>

    <main class="container">
      <a href="/" class="back-link">← cd ..</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> ls</span>
        <span class="flag"> -la</span>
        <span class="arg"> ./presentations/</span>
      </p>

      <div class="content-block">
        <div class="project-entry">
          <p class="project-name"><a href="/presentations/morning-briefing">morning-briefing/</a></p>
          <p class="project-desc">// system design walkthrough — how the daily morning briefing is built. covers data sources, script generation, audio pipeline, blog publishing, and Kling video generation.</p>
          <p class="project-meta">// stack: gpt-4o &middot; openai tts &middot; kling ai &middot; astro &middot; agent river &middot; python</p>
          <p class="project-status">// 8 slides</p>
        </div>
      </div>
    </main>

    <footer class="site-footer"><a href="/privacy">privacy policy</a></footer>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
