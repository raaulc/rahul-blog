---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { experiments, notebooks, selected } from '../data/work';
---

<Base title="work" description="Selected AI systems by Rahul Rathod: a real-time recommender, a daily ranking pipeline and typed AI decisions, plus experiments and notebooks." active="work" ogImage="/og/projects.png">
  <h1 class="sr-only">Work</h1>
  <p class="cmd"><span class="dollar">$</span><span class="command"> ls</span><span class="flag"> --selected</span><span class="arg"> ./work</span></p>
  <p class="page-lede">Systems built end to end, with measured results.</p>
  <div class="work-grid">
    {selected.map((item) => <WorkCard item={item} />)}
  </div>

  <section class="section">
    <p class="cmd"><span class="dollar">$</span><span class="command"> ls</span><span class="arg"> ./experiments</span></p>
    <div class="work-grid two">
      {experiments.map((item) => <WorkCard item={item} compact />)}
    </div>
  </section>

  <section class="section">
    <p class="cmd"><span class="dollar">$</span><span class="command"> ls</span><span class="arg"> ./lab-notebooks</span></p>
    <ul class="notebook-list">
      {notebooks.map((n) => (
        <li>
          <a href={n.href}>{n.title}</a>
          <span>{n.summary}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
