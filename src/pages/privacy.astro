---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const all = await getCollection('posts');
const page = all.find((p) => p.id === 'privacy');
const { Content } = page ? await render(page) : { Content: null };
---

<Base title="privacy policy">

      <a href="/" class="back-link">← cd ..</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> cat</span>
        <span class="arg"> privacy.md</span>
      </p>

      {Content
        ? <article class="post-content"><Content /></article>
        : <div class="content-block"><p>// privacy policy coming soon</p></div>
      }
</Base>
