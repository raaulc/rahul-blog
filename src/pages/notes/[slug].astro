---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return notes.map((note, i) => ({ params: { slug: note.id }, props: { note, prev: notes[i - 1], next: notes[i + 1] } }));
}

const { note, prev, next } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
---

<Base title={note.data.title} type="article" publishedAt={note.data.date} active="notes">
  <a href="/notes" class="back-link">← cd ../notes</a>
  <p class="post-meta-line">{date}<span class="post-meta-sep"> · </span>{note.data.category}{note.data.tags.length > 0 && <><span class="post-meta-sep"> · </span>{note.data.tags.map((t) => `#${t}`).join(' ')}</>}</p>
  <article class="post-content note-content">
    <h1>{note.data.title}</h1>
    <Content />
  </article>
  <nav class="note-pager" aria-label="More notes">
    {prev ? <a href={`/notes/${prev.id}`}>← {prev.data.title}</a> : <span></span>}
    {next ? <a href={`/notes/${next.id}`}>{next.data.title} →</a> : <span></span>}
  </nav>
</Base>
