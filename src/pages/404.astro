---
import Head from '../components/Head.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <Head title="404 — not found" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="navbar-path">
        <span class="p-tilde">~/</span><span class="p-name">rahul</span>
      </a>
      <ul class="navbar-nav">
        <li><a href="/">blog</a></li>
        <li><a href="/projects">projects</a></li>
        <li><a href="/deck">deck</a></li>
        <li><a href="/jev">jev</a></li>
        <li><a href="/about">about</a></li>
      </ul>
    </nav>

    <main class="container">
      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> cd</span>
        <span class="arg"> <span id="path">this-page</span></span>
      </p>
      <p>cd: no such file or directory</p>
      <a href="/" class="back-link">← cd ~</a>
    </main>

    <script>
      document.getElementById('path').textContent = window.location.pathname;
    </script>
  </body>
</html>
