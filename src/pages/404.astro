---
import Base from '../layouts/Base.astro';
---

<Base title="404 — not found" noindex>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> cd</span>
        <span class="arg"> <span id="path">this-page</span></span>
      </p>
      <p>cd: no such file or directory</p>
      <a href="/" class="back-link">← cd ~</a>
  <script>
      document.getElementById('path')!.textContent = window.location.pathname;
    </script>
</Base>
