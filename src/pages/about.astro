---
import { getCollection } from 'astro:content';
import Head from '../components/Head.astro';

const all = await getCollection('posts');
const aboutPost = all.find((p) => p.slug === 'about');
const { Content } = aboutPost ? await aboutPost.render() : { Content: null };
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="about"
      description="Software engineer in Sheffield building agentic AI apps. About Rahul — goals, stack, and what I am working on."
    />
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="navbar-path">
        <span class="p-tilde">~/</span><span class="p-name">rahul</span>
      </a>
      <ul class="navbar-nav">
        <li><a href="/">blog</a></li>
        <li><a href="/projects">projects</a></li>
        <li><a href="/everything-else">everything-else</a></li>
        <li><a href="/presentations">presentations</a></li>
        <li><a href="/about" class="active">about</a></li>
      </ul>
    </nav>

    <main class="container">
      <a href="/" class="back-link">← cd ..</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> cat</span>
        <span class="arg"> about.md</span>
      </p>

      {Content
        ? <article class="post-content"><Content /></article>
        : <div class="content-block"><p>// coming soon</p></div>
      }
    </main>

    <footer class="site-footer"><a href="/privacy">privacy policy</a></footer>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
