---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = await getCollection('posts');
const aboutPost = all.find((p) => p.id === 'about');
const { Content } = aboutPost ? await render(aboutPost) : { Content: null };
---

<Base title="about" description="Rahul Rathod is an AI engineer in the trading department at Flutter UK &amp; Ireland, with 16+ years in software." active="about">

      <a href="/" class="back-link">← cd ..</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> cat</span>
        <span class="arg"> about.md</span>
      </p>

      {Content
        ? <article class="post-content"><Content /></article>
        : <div class="content-block"><p>// coming soon</p></div>
      }
</Base>
