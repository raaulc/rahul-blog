---
import Head from '../../components/Head.astro';
import PaperList from '../../components/PaperList.astro';

const modules = import.meta.glob('../../data/papers/*.json', { eager: true }) as Record<string, { default: any }>;
const days = Object.entries(modules).map(([path, mod]) => {
  const date = path.match(/(\d{4}-\d{2}-\d{2})\.json$/)![1];
  return { ...mod.default, date };
});
days.sort((a, b) => b.date.localeCompare(a.date));

const latest = days[0];
const archive = days.slice(1);

const generated = new Date(latest.generated_at);
const generatedLabel = generated.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="ai paper radar"
      description="Daily-ranked arXiv AI papers, scored by Jev's typed-decision API for relevance and novelty — automated, no manual curation, full history browsable."
    />
    <style>
      .archive-list { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 4px; }
      .archive-list a {
        color: var(--muted);
        font-size: 12.5px;
        text-decoration: none;
        border-bottom: 1px dashed var(--border);
      }
      .archive-list a:hover { color: var(--green); border-color: var(--green); }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="navbar-path">
        <span class="p-tilde">~/</span><span class="p-name">rahul</span>
      </a>
      <ul class="navbar-nav">
        <li><a href="/">blog</a></li>
        <li><a href="/projects" class="active">projects</a></li>
        <li><a href="/deck">deck</a></li>
        <li><a href="/career-game">career</a></li>
        <li><a href="/about">about</a></li>
      </ul>
    </nav>

    <main class="container">
      <a href="/projects" class="back-link">← cd ..</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> cron.daily</span>
        <span class="arg"> paper_ranker.py</span>
        <span class="flag"> # {latest.date}</span>
      </p>

      <div class="content-block" style="border: 1px solid var(--green); padding: 16px 20px; margin-bottom: 28px;">
        <p style="color: var(--green); font-weight: bold; margin-bottom: 8px;">// live, automated · updated {generatedLabel}</p>
        <p style="margin-bottom: 10px;">
          Every morning a GitHub Actions cron pulls the newest papers from {latest.categories.join(', ')} on arXiv,
          scores each one with <a href="https://typesafe.ai" target="_blank" style="color: var(--green);">Jev</a> (TypeSafe AI's typed-decision model — no text generation, just calibrated yes/no + score answers), and ranks them.
        </p>
        <p style="margin-bottom: 6px;">// ranked against:</p>
        <p style="margin: 0 0 10px 0; color: var(--fg);">"{latest.interest}"</p>
        <p>// priority = 0.7 &times; worth-reading confidence + 0.3 &times; novelty score — both from Jev, weighting decided in code</p>
      </div>

      <p class="cmd" style="margin-bottom: 4px;">
        <span class="dollar">$</span>
        <span class="command"> sort</span>
        <span class="flag"> -k1 -rn</span>
        <span class="arg"> ./papers/{latest.date}.json</span>
      </p>

      <PaperList papers={latest.papers} />

      {archive.length > 0 && (
        <>
          <p class="cmd" style="margin: 28px 0 8px;">
            <span class="dollar">$</span>
            <span class="command"> ls</span>
            <span class="flag"> -la</span>
            <span class="arg"> ./papers/archive/</span>
          </p>
          <div class="archive-list">
            {archive.map((d) => (
              <a href={`/projects/ai-paper-radar/${d.date}`}>{d.date}</a>
            ))}
          </div>
        </>
      )}
    </main>

    <footer class="site-footer"><a href="/privacy">privacy policy</a></footer>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
