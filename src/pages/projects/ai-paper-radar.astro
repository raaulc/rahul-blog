---
import papersData from '../../data/papers.json';
import Head from '../../components/Head.astro';

const generated = new Date(papersData.generated_at);
const generatedLabel = generated.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const KIND_LABEL: Record<string, string> = {
  new_method: 'new method',
  benchmark_or_eval: 'benchmark/eval',
  survey_or_position: 'survey/position',
  applied_system: 'applied system',
};
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="ai paper radar"
      description="Daily-ranked arXiv AI papers, scored by Jev's typed-decision API for relevance and novelty — automated, no manual curation."
    />
    <style>
      .paper-entry {
        border-bottom: 1px solid var(--border);
        padding: 14px 0;
      }
      .paper-entry:last-child { border-bottom: none; }
      .paper-rank {
        color: var(--muted);
        font-size: 13px;
        margin-right: 6px;
      }
      .paper-title a {
        color: var(--fg);
        text-decoration: none;
      }
      .paper-title a:hover { color: var(--green); text-decoration: underline; }
      .paper-meta {
        font-size: 12.5px;
        color: var(--muted);
        margin-top: 4px;
      }
      .paper-meta .stat { color: var(--green); }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="navbar-path">
        <span class="p-tilde">~/</span><span class="p-name">rahul</span>
      </a>
      <ul class="navbar-nav">
        <li><a href="/">blog</a></li>
        <li><a href="/projects" class="active">projects</a></li>
        <li><a href="/deck">deck</a></li>
        <li><a href="/career-game">career</a></li>
        <li><a href="/about">about</a></li>
      </ul>
    </nav>

    <main class="container">
      <a href="/projects" class="back-link">← cd ..</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> cron.daily</span>
        <span class="arg"> paper_ranker.py</span>
      </p>

      <div class="content-block" style="border: 1px solid var(--green); padding: 16px 20px; margin-bottom: 28px;">
        <p style="color: var(--green); font-weight: bold; margin-bottom: 8px;">// live, automated · updated {generatedLabel}</p>
        <p style="margin-bottom: 10px;">
          Every morning a GitHub Actions cron pulls the newest papers from {papersData.categories.join(', ')} on arXiv,
          scores each one with <a href="https://typesafe.ai" target="_blank" style="color: var(--green);">Jev</a> (TypeSafe AI's typed-decision model — no text generation, just calibrated yes/no + score answers), and ranks them.
        </p>
        <p style="margin-bottom: 6px;">// ranked against:</p>
        <p style="margin: 0 0 10px 0; color: var(--fg);">"{papersData.interest}"</p>
        <p>// priority = 0.7 &times; worth-reading confidence + 0.3 &times; novelty score — both from Jev, weighting decided in code</p>
      </div>

      <p class="cmd" style="margin-bottom: 4px;">
        <span class="dollar">$</span>
        <span class="command"> sort</span>
        <span class="flag"> -k1 -rn</span>
        <span class="arg"> ./papers.json</span>
      </p>

      <div class="content-block">
        {papersData.papers.map((p: any, i: number) => (
          <div class="paper-entry">
            <p class="paper-title">
              <span class="paper-rank">{String(i + 1).padStart(2, '0')}.</span>
              <a href={p.link} target="_blank" rel="noopener">{p.title}</a>
            </p>
            <p class="paper-meta">
              <span class="stat">{Math.round(p.worth_reading * 100)}%</span> worth reading &middot;
              novelty <span class="stat">{p.novelty.toFixed(1)}/3</span> &middot;
              {KIND_LABEL[p.kind] ?? p.kind} &middot;
              {p.category}
            </p>
          </div>
        ))}
      </div>
    </main>

    <footer class="site-footer"><a href="/privacy">privacy policy</a></footer>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
