---
import briefings from '../../data/briefings.json';
import Head from '../../components/Head.astro';
const entries = [...briefings].reverse(); // newest first
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="daily media update"
      description="Daily morning briefing — GPT-4o writes a John Oliver-style monologue from emails, AI news, and reminders. Read aloud by OpenAI TTS."
    />
  </head>
  <body>
    <nav class="navbar">
      <span class="navbar-path">
        <span class="p-tilde">~/</span><span class="p-name">rahul</span>
      </span>
      <ul class="navbar-nav">
        <li><a href="/">blog</a></li>
        <li><a href="/projects" class="active">projects</a></li>
        <li><a href="/everything-else">everything-else</a></li>
        <li><a href="/presentations">presentations</a></li>
        <li><a href="/about">about</a></li>
      </ul>
    </nav>

    <main class="container">
      <a href="/projects" class="back-link">← cd ..</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> ls</span>
        <span class="flag"> -la</span>
        <span class="arg"> ./daily-media-update/</span>
      </p>

      <div class="content-block" style="margin-bottom: 12px;">
        <p>// daily morning briefing — John Oliver-style monologue from reminders, emails, and AI news</p>
        <p>// generated by GPT-4o · read by OpenAI TTS (fable)</p>
      </div>

      {entries.map((entry) => (
        <div class="briefing-entry">
          <p class="briefing-date">// {entry.label}</p>
          <audio controls class="briefing-audio">
            <source src={entry.audio} type="audio/mpeg" />
          </audio>
          {entry.video && (
            <video controls style="width: 100%; margin-bottom: 10px; border: 1px solid var(--border);">
              <source src={entry.video} type="video/mp4" />
            </video>
          )}
          <details class="briefing-transcript">
            <summary>transcript</summary>
            <p>{entry.transcript}</p>
          </details>
        </div>
      ))}
    </main>

    <footer class="site-footer"><a href="/privacy">privacy policy</a></footer>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
