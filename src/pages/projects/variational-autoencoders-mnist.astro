---
import Head from '../../components/Head.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="variational autoencoders on mnist"
      description="Build a Conditional VAE in PyTorch that generates handwritten digits on demand. Reparameterisation trick, KL divergence, conditional generation."
    />
    <style>
      .notebook-frame {
        width: 100%;
        height: 85vh;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: #fff;
        margin-top: 16px;
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="navbar-path">
        <span class="p-tilde">~/</span><span class="p-name">rahul</span>
      </a>
      <ul class="navbar-nav">
        <li><a href="/">blog</a></li>
        <li><a href="/projects" class="active">projects</a></li>
        <li><a href="/deck">deck</a></li>
        <li><a href="/about">about</a></li>
      </ul>
    </nav>

    <main class="container">
      <a href="/projects" class="back-link">← cd ..</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> jupyter</span>
        <span class="arg"> notebook variational-autoencoders-mnist.ipynb</span>
      </p>

      <div class="content-block" style="margin-bottom: 12px;">
        <p>// conditional vae on mnist — generate any handwritten digit on demand from a sampled latent vector</p>
        <p>// stack: pytorch &middot; torchvision &middot; matplotlib</p>
        <a href="/notebooks/variational-autoencoders-mnist.html" target="_blank" style="font-size: 13px; color: var(--green);">↗ open in full tab</a>
      </div>

      <iframe
        src="/notebooks/variational-autoencoders-mnist.html"
        class="notebook-frame"
        title="Variational Autoencoders on MNIST Notebook"
      ></iframe>
    </main>

    <footer class="site-footer"><a href="/privacy">privacy policy</a></footer>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
