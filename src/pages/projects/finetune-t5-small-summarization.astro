---
import Head from '../../components/Head.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="finetune t5-small — summarization"
      description="Fine-tuning Google T5-Small on the SAMSum dialogue summarization dataset using HuggingFace Transformers."
    />
    <style>
      .notebook-frame {
        width: 100%;
        height: 85vh;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: #fff;
        margin-top: 16px;
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="navbar-path">
        <span class="p-tilde">~/</span><span class="p-name">rahul</span>
      </a>
      <ul class="navbar-nav">
        <li><a href="/">blog</a></li>
        <li><a href="/projects" class="active">projects</a></li>
        <li><a href="/deck">deck</a></li>
        <li><a href="/about">about</a></li>
      </ul>
    </nav>

    <main class="container">
      <a href="/projects" class="back-link">← cd ..</a>

      <p class="cmd">
        <span class="dollar">$</span>
        <span class="command"> jupyter</span>
        <span class="arg"> notebook finetune-t5-small-summarization.ipynb</span>
      </p>

      <div class="content-block" style="margin-bottom: 12px;">
        <p>// fine-tuning google t5-small on samsum dialogue summarization dataset</p>
        <p>// stack: huggingface transformers · pytorch · datasets · accelerate</p>
        <a href="/notebooks/finetune-t5-small-summarization.html" target="_blank" style="font-size: 13px; color: var(--green);">↗ open in full tab</a>
      </div>

      <iframe
        src="/notebooks/finetune-t5-small-summarization.html"
        class="notebook-frame"
        title="Fine-tune T5-Small Summarization Notebook"
      ></iframe>
    </main>

    <footer class="site-footer"><a href="/privacy">privacy policy</a></footer>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
