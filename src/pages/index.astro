---
import { getCollection } from 'astro:content';
import Analytics from '@vercel/analytics/astro';

const posts = (await getCollection('posts'))
  .filter((p) => p.data.type !== 'page')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];

function readingTime(post) {
  const words = post.body.split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rahul -- AI Engineering & Building in Public</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="stylesheet" href="/styles/global.css" />
    <Analytics />
    <script>
      const saved = localStorage.getItem('theme');
      if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="site-name"><img src="/logo.svg" alt="Rahul" />Rahul</a>
        <nav>
          <a href="/">Blogs</a>
          <a href="/projects">Projects</a>
          <a href="/everything-else">Everything Else</a>
          <a href="/about">About</a>
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">☀</button>
        </nav>
      </div>
    </header>
    <script>
      const btn = document.getElementById('theme-toggle');
      const root = document.documentElement;
      function update() {
        const dark = root.getAttribute('data-theme') === 'dark';
        btn.textContent = dark ? '☀' : '☾';
      }
      update();
      btn.addEventListener('click', () => {
        const dark = root.getAttribute('data-theme') === 'dark';
        root.setAttribute('data-theme', dark ? 'light' : 'dark');
        localStorage.setItem('theme', dark ? 'light' : 'dark');
        update();
      });
    </script>

    <div class="page-layout">
      <main>
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-item">
              <a href={`/posts/${post.slug}`} class="post-title">{post.data.title}</a>
              {post.data.description && (
                <p class="post-description">{post.data.description}</p>
              )}
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-GB', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span class="dot">·</span>
                <span>{readingTime(post)} min read</span>
              </div>
            </li>
          ))}
          {posts.length === 0 && <p class="empty">No posts yet.</p>}
        </ul>
      </main>

      <aside>
        <div class="sidebar-card">
          <p class="bio">
            Software engineer and indie developer. Writing about agentic AI, building products, and everything in between.
          </p>
          <a href="/about" class="subscribe-btn">About me</a>
        </div>

        {allTags.length > 0 && (
          <div class="sidebar-card">
            <h3 class="sidebar-heading">Topics</h3>
            <div class="tags">
              {allTags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
    <footer class="site-footer"><a href="/privacy">Privacy Policy</a></footer>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
