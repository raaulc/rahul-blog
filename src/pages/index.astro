---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import PostList from '../components/PostList.astro';
import pic from '../assets/pic.jpg';
import { career, selected } from '../data/work';

const posts = (await getCollection('posts'))
  .filter((p) => p.data.type === 'post')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<Base
  title="Rahul Rathod — AI systems, from prototype to production"
  description="AI engineer with 15+ years in software. I take AI from research prototype to production: recommendation and ranking, LLM agents, and evaluation."
>
  <section class="hero">
    <p class="cmd"><span class="dollar">$</span><span class="command"> whois</span><span class="arg"> rahul</span></p>
    <div class="hero-id">
      <Picture src={pic} alt="Rahul Rathod" width={88} height={88} formats={['avif', 'webp']} class="hero-photo" loading="eager" />
      <div>
        <h1 class="hero-name">Rahul Rathod</h1>
        <p class="hero-role">AI engineer · 15+ years shipping software · Sheffield, UK</p>
      </div>
    </div>
    <p class="hero-lede">
      I take AI from research prototype to production: recommendation and ranking, LLM agents, and the evaluation
      that tells you whether any of it works. Currently an AI engineer at Flutter UK &amp; Ireland; before that,
      a technical lead and consultant at Capgemini, Best Buy and Marks &amp; Spencer.
    </p>
    <div class="cta-row">
      <a class="btn primary" href="/projects">selected work →</a>
      <a class="btn" href="/about">about &amp; career</a>
      <a class="btn" href="https://www.linkedin.com/in/raaulc/">linkedin</a>
    </div>
  </section>

  <section class="section">
    <p class="cmd"><span class="dollar">$</span><span class="command"> ls</span><span class="flag"> --selected</span><span class="arg"> ./work</span></p>
    <div class="work-grid">
      {selected.map((item) => <WorkCard item={item} />)}
    </div>
    <a class="more-link" href="/projects">all work, experiments and notebooks →</a>
  </section>

  <section class="section">
    <p class="cmd"><span class="dollar">$</span><span class="command"> ls</span><span class="flag"> -lt</span><span class="arg"> ./writing</span><span class="pipe"> | head</span></p>
    <PostList posts={posts} />
    <a class="more-link" href="/writing">all writing →</a>
  </section>

  <section class="section">
    <p class="cmd"><span class="dollar">$</span><span class="command"> cat</span><span class="arg"> career.log</span></p>
    <ol class="timeline">
      {career.map((c) => (
        <li>
          <span class="tl-years">{c.years}</span>
          <span class="tl-org">{c.org}</span>
          <span class="tl-role">{c.role}</span>
        </li>
      ))}
    </ol>
  </section>
</Base>
