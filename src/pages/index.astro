---
import { getCollection } from 'astro:content';
import Head from '../components/Head.astro';

const posts = (await getCollection('posts'))
  .filter((p) => p.data.type !== 'page')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function readingTime(post) {
  const words = post.body.split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

function fmtDate(d) {
  return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
}
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="rahul — ai engineering & building in public"
      description="Software engineer in Sheffield building agentic AI apps and writing about AI engineering."
    />
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="navbar-path">
        <span class="p-tilde">~/</span><span class="p-name">rahul</span>
      </a>
      <ul class="navbar-nav">
        <li><a href="/" class="active">blog</a></li>
        <li><a href="/projects">projects</a></li>
        <li><a href="/everything-else">everything-else</a></li>
        <li><a href="/presentations">presentations</a></li>
        <li><a href="/about">about</a></li>
      </ul>
    </nav>

    <main class="container">

      <!-- Boot -->
      <div class="boot">
        <span class="boot-label">output</span>
        <div class="boot-line"><span class="ok">[  OK  ]</span><span class="boot-msg">Started <span class="hi">raaulc.com</span> — personal site and second brain</span></div>
        <div class="boot-line"><span class="ok">[  OK  ]</span><span class="boot-msg">Loaded user profile: <span class="hi">software engineer, sheffield uk</span></span></div>
        <div class="boot-line"><span class="info-tag">[ INFO ]</span><span class="boot-msg">Learning: agentic AI, AI engineering, LLMs</span></div>
      </div>

      <!-- Whois -->
      <div class="section">
        <p class="cmd">
          <span class="dollar">$</span>
          <span class="command"> whois</span>
          <span class="arg"> rahul</span>
        </p>
        <div class="bio-layout">
          <div class="bio-photo">
            <img src="/images/pic.png" alt="Rahul" />
          </div>
          <div class="bio-fields">
            <div class="bio-field">
              <span class="bio-key">name</span>
              <span class="bio-sep">:</span>
              <span class="bio-val bright">Rahul</span>
            </div>
            <div class="bio-field">
              <span class="bio-key">role</span>
              <span class="bio-sep">:</span>
              <span class="bio-val orange">software engineer</span>
            </div>
            <div class="bio-field">
              <span class="bio-key">location</span>
              <span class="bio-sep">:</span>
              <span class="bio-val">Sheffield, UK</span>
            </div>
            <div class="bio-field">
              <span class="bio-key">learning</span>
              <span class="bio-sep">:</span>
              <span class="bio-val">agentic AI, LLMs, AI engineering, system design</span>
            </div>
            <div class="chips">
              <a class="chip" href="https://github.com/raaulc" target="_blank" rel="noopener">◈ github</a>
              <a class="chip" href="/about">✦ about me</a>
              <a class="chip" href="/projects">⬡ projects</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Blog posts -->
      <div class="section">
        <p class="cmd">
          <span class="dollar">$</span>
          <span class="command"> ls</span>
          <span class="flag"> -lt</span>
          <span class="arg"> ./blog/</span>
          <span class="pipe"> | head</span>
        </p>
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-entry">
              <span class="post-date">{fmtDate(post.data.date)}</span>
              <a href={`/posts/${post.slug}`} class="post-link">{post.data.title}</a>
              <span class="post-mins">{readingTime(post)}m</span>
            </li>
          ))}
          {posts.length === 0 && <p class="empty-msg">// no posts yet — check back soon</p>}
        </ul>
      </div>

      <!-- Terminal -->
      <div class="terminal-section">
        <div class="t-row">
          <span class="t-prompt">rahul@home:~$</span>
          <input class="t-input" type="text" placeholder="type 'help'" autocomplete="off" spellcheck="false" id="t-input" />
        </div>
        <div class="t-output" id="t-output"></div>
      </div>

    </main>

    <footer class="site-footer"><a href="/privacy">privacy policy</a></footer>

    <script defer src="/_vercel/insights/script.js"></script>

    <script>
      const input = document.getElementById('t-input');
      const output = document.getElementById('t-output');

      const cmds = {
        help: '  available commands: help, about, blog, projects, clear',
        about: '  → /about — software engineer based in sheffield building agentic AI apps',
        blog: '  → /     — read all blog posts',
        projects: '  → /projects — coming soon',
        clear: '__clear__',
      };

      input.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        const val = input.value.trim().toLowerCase();
        input.value = '';
        if (!val) return;
        const res = cmds[val];
        if (res === '__clear__') {
          output.textContent = '';
        } else if (res) {
          output.textContent = res;
        } else {
          output.textContent = `  command not found: ${val}. type 'help' for options.`;
        }
      });
    </script>
  </body>
</html>
